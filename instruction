# build medical knowledge graph
cd ~/scratchdata/Yuanqi/neo4j-graphrag-python/dataset/medical
nohup python3 build_kg.py > medical_kg_build.log 2>&1 &
tail -f medical_kg_build.log

# set environment variables
source ~/.bashrc
echo $NEO4J_PASSWORD

ollama serve & # start ollama server

# list all nodes and relations in the graph
MATCH (n)-[r]->(m) RETURN n, r, m

# create vector index for the graph
CREATE VECTOR INDEX chunk_embedding_index IF NOT EXISTS
FOR (c:Chunk) ON (c.embedding)
OPTIONS {indexConfig: {
  `vector.dimensions`: 1024,
  `vector.similarity_function`: 'cosine'
}}

# delete all nodes in the graph
MATCH (n) DETACH DELETE n