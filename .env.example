APP_PROFILE=local
RETRIEVER_MODE=auto
# local defaults to ollama; cloud defaults to azure-openai unless overridden.
LLM_BACKEND=
USE_RERANKER=false

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_VECTOR_INDEX=chunk_embedding_index
NEO4J_FULLTEXT_INDEX=chunk_fulltext_index

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:30b-a3b
OLLAMA_EMBED_MODEL=bge-m3:latest

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
