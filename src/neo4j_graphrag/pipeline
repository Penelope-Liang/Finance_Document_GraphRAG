# 0) environment setup
cd ~/scratchdata/Yuanqi/neo4j-graphrag-python
source /opt/conda/etc/profile.d/conda.sh
conda activate graphrag-gpu
export PYTHONPATH=$PWD/src
export NEO4J_URI=bolt://127.0.0.1:7687
export NEO4J_USER=neo4j
export NEO4J_PASSWORD='test12345'
mkdir -p logs

# 1) build graph
RUN_ID=$(date +%Y%m%d_%H%M%S)
CHUNKS=output/run_20260311_210657/chunks.ndjson
LOG="logs/build_graph_${RUN_ID}.log"

nohup python -m neo4j_graphrag.tools.build_graph \
  --chunks-path "$CHUNKS" \
  --state-path "output/run_20260311_210657/graph_state.json" \
  --purge-doc-first \
  > "$LOG" 2>&1 &

echo "PID=$! LOG=$LOG"
tail -f "$LOG"

# 2) build faiss index
RUN_ID=$(date +%Y%m%d_%H%M%S)
LATEST=output/run_20260311_210657
LOG="logs/faiss_${RUN_ID}.log"

nohup python -m neo4j_graphrag.dense_retrieval.faiss_builder \
  --chunks-path "${LATEST}/chunks.ndjson" \
  --index-out "${LATEST}/chunks.index" \
  --mapping-out "${LATEST}/intid_to_chunkid.jsonl" \
  --meta-out "${LATEST}/faiss_meta.json" \
  --embedder-backend sentence-transformers \
  --embedder-model BAAI/bge-m3 \
  > "$LOG" 2>&1 &

echo "PID=$! LOG=$LOG"
tail -f "$LOG"


# 3) run rag and graphrag compare query
RUN_ID=$(date +%Y%m%d_%H%M%S)
LATEST=output/run_20260311_210657
LOG="logs/query_compare_${RUN_ID}.log"

nohup python -m neo4j_graphrag.query.router \
  --mode compare \
  --retrieval hybrid \
  --dense-backend faiss \
  --faiss-index-path "${LATEST}/chunks.index" \
  --faiss-mapping-path "${LATEST}/intid_to_chunkid.jsonl" \
  --questions-file output/financebench/questions.txt \
  --output "${LATEST}/pred_compare.json" \
  > "$LOG" 2>&1 &

echo "PID=$! LOG=$LOG"
tail -f "$LOG"


# 4) evaluate f1
RUN_ID=$(date +%Y%m%d_%H%M%S)
LATEST=output/run_20260311_210657
LOG="logs/eval_f1_${RUN_ID}.log"

nohup python evaluate_f1.py \
  --pred-path "${LATEST}/pred_compare.json" \
  --qa-path output/financebench/qa.jsonl \
  --out-dir "${LATEST}/eval_f1" \
  > "$LOG" 2>&1 &

echo "PID=$! LOG=$LOG"
tail -f "$LOG"
